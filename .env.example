# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bon_gout_grand_kloto

# Administration: choose a long unique password and a random secret (32+ chars)
ADMIN_EMAIL=admin@bongout.tg
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# USSD / Mobile money
# Configure the exact operator code/template after validating it with the provider.
# Example template: *XXX*{amount}*{reference}#
# Use {phone} only if the operator's official flow requires it.
USSD_TMoney_TEMPLATE=
USSD_Flooz_TEMPLATE=
USSD_DEFAULT_OPERATOR=TMoney

# OneSignal (optional; push setup can be completed later)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
