# ============================================================
# BON GOÛT DU GRAND KLOTO — variables d'environnement
# Copier vers .env.local (local) ou saisir dans Vercel :
# Project Settings > Environment Variables. Après modification
# sur Vercel : redéployer. Vérifier avec : npm run check:env
# NE JAMAIS committer de vraies valeurs.
# ============================================================

# --- Obligatoire : MongoDB Atlas ---
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bon_gout_grand_kloto

# --- Obligatoire : signature des sessions (32 caractères minimum, aléatoires) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# --- Obligatoire pour photos/vidéos : Cloudinary (envoi direct navigateur -> Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paiement mobile USSD ---
# Modèle exact fourni par l'opérateur. Variables possibles : {amount} (montant en FCFA)
# et {phone} (numéro du client, chiffres seulement). Le code final ne contient que
# des chiffres, * et #. Forme (exemple fictif, NE PAS utiliser tel quel) : *123*{amount}#
USSD_TMoney_TEMPLATE=
USSD_Flooz_TEMPLATE=

# --- URL publique du site (liens contenus dans les notifications push) ---
NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app

# --- OneSignal (notifications push) ---
# App ID : OneSignal > Settings > Keys & IDs (format xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
# Clé REST API de l'APPLICATION (commence par os_v2_app_). Pas la clé d'organisation (os_v2_org_).
ONESIGNAL_REST_API_KEY=
