# ============================================================
# BON GOÛT DU GRAND KLOTO — variables d'environnement
# Copier ce fichier vers .env.local (local) ou les saisir dans
# Vercel > Project Settings > Environment Variables.
# NE JAMAIS committer de vraies valeurs.
# ============================================================

# --- Obligatoire : MongoDB Atlas ---
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bon_gout_grand_kloto

# --- Obligatoire : signature des sessions (32 caractères minimum, aléatoires) ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# --- Obligatoire pour les photos/vidéos : Cloudinary (clés privées côté serveur uniquement) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paiement mobile USSD (modèles à valider auprès de TMoney / Flooz) ---
# Variables disponibles dans le modèle : {amount} {reference} {phone}
# Exemple de forme (NE PAS utiliser tel quel) : *XXX*{amount}*{reference}#
USSD_TMoney_TEMPLATE=
USSD_Flooz_TEMPLATE=

# --- URL publique du site (prévu pour les liens et notifications — phase 2) ---
NEXT_PUBLIC_SITE_URL=https://votre-site.vercel.app

# --- OneSignal (phase 2 : prévu, non branché dans cette version) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
